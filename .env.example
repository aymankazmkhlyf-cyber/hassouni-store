# ---------------------------------------------------------------
# Hassouni Digital Services — environment variables (placeholders only)
# Copy to `.env` for local development. NEVER commit real values.
# ---------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / local).
# Production providers usually require `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Separate database used ONLY by `npm run test:integration`.
# It is wiped and re-migrated on every test run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_test"

# Public base URL of the site, without trailing slash.
APP_URL="http://localhost:3000"

# Long random string (>= 32 chars) used to derive HMAC keys for
# rate-limit identifiers. Generate with: openssl rand -base64 48
APP_SECRET="replace-with-a-long-random-string"

# Set to "true" only when running behind a proxy you trust (Vercel,
# Render, Cloudflare) so the client IP is read from x-forwarded-for.
TRUST_PROXY="true"

# Used only by `npm run admin:create` (first-admin bootstrap).
# Remove these from the environment after the admin account exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
